<Window x:Class="Hourstone.Companion.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Hourstone.Companion.App" Title="Hourstone Companion" Width="1536" Height="992" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" Icon="Assets/Hourstone.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="TableValueText" TargetType="TextBlock">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="ProductLinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="LinkBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="Transparent">
              <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                <Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FooterLinkButton" TargetType="Button" BasedOn="{StaticResource ProductLinkButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="FooterLinkSurface" Padding="{TemplateBinding Padding}" Background="Transparent">
              <TextBlock x:Name="FooterLinkText" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="ChromeRoot" BorderBrush="#486071" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="18,0">
            <Image Source="Assets/Logo.png" Width="30" Height="30" Margin="0,0,10,0" />
            <TextBlock Text="Hourstone Companion" VerticalAlignment="Center" FontSize="17" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" PreviewKeyDown="CaptionButton_KeyDown" ToolTip="{Binding T[CaptionMinimize]}" AutomationProperties.Name="{Binding T[CaptionMinimize]}" />
            <Button x:Name="MaximizeButton" Click="Maximize_Click" PreviewKeyDown="CaptionButton_KeyDown">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                  <Setter Property="Content" Value="&#xE922;" />
                  <Setter Property="ToolTip" Value="{Binding T[CaptionMaximize]}" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding T[CaptionMaximize]}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState,RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Content" Value="&#xE923;" />
                      <Setter Property="ToolTip" Value="{Binding T[CaptionRestore]}" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding T[CaptionRestore]}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Tag="Close" Content="&#xE8BB;" Click="Close_Click" PreviewKeyDown="CaptionButton_KeyDown" ToolTip="{Binding T[CaptionCloseTooltip]}" AutomationProperties.Name="{Binding T[CaptionClose]}" AutomationProperties.AcceleratorKey="Alt+F4" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="256" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="220" />
              <RowDefinition Height="*" />
              <RowDefinition Height="80" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="Assets/Logo.png" Width="130" Height="130" />
              <TextBlock Text="Hourstone" FontFamily="Georgia" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Gold}" HorizontalAlignment="Center" />
              <TextBlock Text="C O M P A N I O N" FontSize="13" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="1">
              <RadioButton x:Name="OverviewNav" Style="{StaticResource Nav}" IsChecked="True" Tag="Overview" Checked="Navigate">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource Glyph}" Width="45" />
                  <TextBlock Text="{Binding T[Overview]}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="18" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ClientsNav" Style="{StaticResource Nav}" Tag="Clients" Checked="Navigate">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource Glyph}" Width="45" />
                  <TextBlock Text="{Binding T[Clients]}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="18" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="SyncNav" Style="{StaticResource Nav}" Tag="Sync" Checked="Navigate">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource Glyph}" Width="45" />
                  <TextBlock Text="{Binding T[Sync]}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="18" />
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" Tag="Settings" Checked="Navigate">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource Glyph}" Width="45" />
                  <TextBlock Text="{Binding T[Settings]}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="18" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="27,0" VerticalAlignment="Center">
              <TextBlock Text="" Style="{StaticResource Glyph}" Margin="0,0,17,0" />
              <StackPanel>
                <TextBlock Text="{Binding DeviceName}" FontSize="14" />
                <TextBlock Text="{Binding T[Local]}" Foreground="{DynamicResource Muted}" FontSize="13" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="26,22,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
          </Grid.RowDefinitions>
          <Border x:Name="Notice" Visibility="Collapsed" BorderBrush="{DynamicResource Cyan}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Panel}" Padding="14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button x:Name="NoticeSourceButton" Grid.Column="1" Visibility="Collapsed" Content="{Binding T[ShowSources]}" Click="ShowSources_Click" Margin="14,0,0,0" Padding="12,7" />
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid x:Name="OverviewPage">
              <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="148" />
                <RowDefinition Height="56" />
                <RowDefinition Height="44" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="254" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="12,3,0,0">
                  <TextBlock Text="{Binding T[Hero]}" FontSize="48" FontWeight="Bold" />
                  <TextBlock Text="{Binding T[Subtitle]}" Foreground="{DynamicResource Muted}" FontSize="23" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button x:Name="SyncNowButton" Click="SyncNow_Click" IsEnabled="{Binding IsIdle}" ToolTip="{Binding T[CheckTooltip]}" AutomationProperties.Name="{Binding T[CheckNow]}" AutomationProperties.HelpText="{Binding T[CheckTooltip]}" Padding="22,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="23" Margin="0,0,13,0" />
                      <TextBlock Text="{Binding T[CheckNow]}" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" FontSize="14" />
                  <TextBlock Text="{Binding LastSync}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.12*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="39" VerticalAlignment="Top" Margin="0,7,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding T[SavedTime]}" Foreground="{DynamicResource Muted}" FontSize="18" />
                        <TextBlock Text="{Binding TotalTime}" Foreground="{DynamicResource Gold}" FontWeight="Bold" FontSize="52" />
                        <TextBlock Text="{Binding TotalDays}" Foreground="{DynamicResource Muted}" FontSize="18" />
                      </StackPanel>
                    </Grid>
                  </Viewbox>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="38" VerticalAlignment="Top" Margin="0,7,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding T[Characters]}" Foreground="{DynamicResource Muted}" FontSize="18" />
                        <TextBlock Text="{Binding CharacterCount}" FontWeight="Bold" FontSize="50" Margin="0,1,0,0" />
                      </StackPanel>
                    </Grid>
                  </Viewbox>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="38" VerticalAlignment="Top" Margin="0,7,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="WoW-Clients" Foreground="{DynamicResource Muted}" FontSize="18" />
                        <TextBlock Text="{Binding ClientCount}" FontWeight="Bold" FontSize="50" Margin="0,1,0,0" />
                      </StackPanel>
                    </Grid>
                  </Viewbox>
                </Border>
              </Grid>
              <Grid Grid.Row="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ListTitle}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding T[RemovalHint]}" />
                <Button x:Name="RemovedCharactersButton" Grid.Column="1" Content="{Binding ToggleRemovedLabel}" Click="ToggleRemoved_Click" Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.7*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width=".9*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Padding="48,6,12,6" AutomationProperties.Name="{Binding T[Search]}" />
                  <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="21" Margin="16,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                  <TextBlock Text="{Binding T[Search]}" Margin="50,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="{Binding SearchHintVisibility}" />
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" AutomationProperties.Name="{Binding T[Clients]}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Realms}" SelectedItem="{Binding SelectedRealm}" AutomationProperties.Name="Realm" />
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="4">
                  <UniformGrid Columns="2">
                    <Button x:Name="HoursButton" Style="{StaticResource TimeFormatButton}" Content="{Binding T[Hours]}" Click="Hours_Click" Tag="{Binding IsHours}" Background="{Binding HoursBackground}" Foreground="{Binding HoursForeground}" />
                    <Button x:Name="DaysButton" Style="{StaticResource TimeFormatButton}" Content="{Binding T[Days]}" Click="Days_Click" Tag="{Binding IsDays}" Background="{Binding DaysBackground}" Foreground="{Binding DaysForeground}" />
                  </UniformGrid>
                </Border>
              </Grid>
              <Border Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                  </Grid.RowDefinitions>
                  <DataGrid x:Name="CharacterGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" RowHeight="64" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True">
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="Charakter" Width="2.1*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="35" Height="35" HorizontalAlignment="Left" CornerRadius="5" BorderBrush="{Binding Color}" BorderThickness="1" Background="{DynamicResource Panel}" Margin="3,0,0,0">
                                <Image Source="{Binding ClassIconPath}" Width="31" Height="31" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="13" />
                                <TextBlock Text="{Binding GuildLine}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Client" Width="1.3*" SortMemberPath="Client">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                              <Image Source="{Binding ClientIconPath}" Width="28" Height="28" Margin="0,0,16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                              <TextBlock Text="{Binding Client}" VerticalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn ElementStyle="{StaticResource TableValueText}" Header="Spielzeit" Width="1.1*" Binding="{Binding Time}" SortMemberPath="Seconds" />
                      <DataGridTextColumn ElementStyle="{StaticResource TableValueText}" Header="Aktualisiert" Width="1*" Binding="{Binding Age}" SortMemberPath="UpdatedAt" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel x:Name="EmptyState" Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="550">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="16" />
                  </StackPanel>
                  <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding RowSummary}" Foreground="{DynamicResource Muted}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding T[RemovalHint]}" />
                      <Button x:Name="CharacterActionButton" Grid.Column="1" Content="{Binding CharacterActionLabel}" Click="CharacterAction_Click" IsEnabled="{Binding CanChangeCharacter}" ToolTip="{Binding T[RemovalHint]}" Padding="10,4" Margin="12,3,0,3" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </Grid>
            <ScrollViewer x:Name="ClientsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="{Binding T[Clients]}" FontSize="40" FontWeight="Bold" />
                <TextBlock Text="{Binding T[ClientsIntro]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,24" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                  <StackPanel>
                    <TextBlock Text="{Binding T[AddonSetupTitle]}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding T[AddonSetupSteps]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,9,0,14" />
                    <WrapPanel>
                      <Button x:Name="AddonDownloadButton" Content="{Binding T[AddonDownload]}" Style="{StaticResource PrimaryButton}" Tag="{x:Static local:ProductLink.AddonCurseForge}" Click="OpenProductLink_Click" ToolTip="{Binding T[AddonDownloadTooltip]}" AutomationProperties.Name="{Binding T[AddonDownload]}" AutomationProperties.HelpText="{Binding T[ExternalBrowserHint]}" Margin="0,0,12,8" />
                      <Button x:Name="AddonGitHubButton" Content="{Binding T[AddonGitHub]}" Style="{StaticResource ProductLinkButton}" FontSize="15" Padding="8,10" Tag="{x:Static local:ProductLink.AddonGitHub}" Click="OpenProductLink_Click" ToolTip="{Binding T[AddonGitHubTooltip]}" AutomationProperties.Name="{Binding T[AddonGitHub]}" AutomationProperties.HelpText="{Binding T[ExternalBrowserHint]}" Margin="0,0,0,8" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <WrapPanel>
                  <Button Content="{Binding T[AddWoW]}" Click="AddWoW_Click" Margin="0,0,12,12" />
                  <Button Content="{Binding T[Discover]}" Click="Discover_Click" Margin="0,0,0,12" />
                </WrapPanel>
                <TextBlock Text="{Binding T[AccountSources]}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,12" />
                <StackPanel x:Name="SourcesPanel" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SyncPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="{Binding T[Sync]}" FontSize="40" FontWeight="Bold" />
                <TextBlock Text="{Binding T[SyncIntro]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,24" />
                <Border x:Name="SyncSetupCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="1" Foreground="{DynamicResource Cyan}" FontWeight="SemiBold" />
                      <TextBlock x:Name="SyncStepFirstText" Grid.Column="1" Text="{Binding T[SyncStepFirst]}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Grid.Row="1" Text="2" Foreground="{DynamicResource Cyan}" FontWeight="SemiBold" />
                      <TextBlock x:Name="SyncStepOtherText" Grid.Row="1" Grid.Column="1" Text="{Binding T[SyncStepOther]}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Grid.Row="2" Text="3" Foreground="{DynamicResource Cyan}" FontWeight="SemiBold" />
                      <TextBlock x:Name="SyncStepAvailabilityText" Grid.Row="2" Grid.Column="1" Text="{Binding T[SyncStepAvailability]}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock x:Name="SyncAccountHintText" Text="{Binding T[SyncAccountHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,6" />
                    <TextBlock x:Name="SyncLocalHintText" Text="{Binding T[SyncLocalHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                  </StackPanel>
                </Border>
                <Border x:Name="SyncFolderCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="{Binding T[SyncFolderLabel]}" FontSize="20" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="12" Margin="0,10,0,12">
                      <TextBlock x:Name="FolderText" TextWrapping="Wrap" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
                    </Border>
                    <WrapPanel>
                      <Button x:Name="ChooseFolderButton" Content="{Binding T[ChooseFolder]}" Click="ChooseFolder_Click" Margin="0,0,12,12" />
                      <Button x:Name="PauseButton" Content="{Binding T[Pause]}" Click="Pause_Click" ToolTip="{Binding T[SyncPauseHint]}" Margin="0,0,12,12" />
                      <Button x:Name="DetachButton" Content="{Binding T[Detach]}" Click="Detach_Click" Margin="0,0,0,12" />
                    </WrapPanel>
                    <TextBlock x:Name="PublicationText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SyncPauseHintText" Text="{Binding T[SyncPauseHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border x:Name="SyncWoWCard" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding T[SyncWoWTitle]}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="WoWStatusText" TextWrapping="Wrap" Margin="0,10,0,10" />
                    <TextBlock x:Name="SyncWoWLoadHintText" Text="{Binding T[SyncWoWLoadHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="SyncCheckHint" Text="{Binding T[CheckSaveHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding T[Devices]}" FontSize="24" FontWeight="SemiBold" Margin="0,25,0,15" />
                <StackPanel x:Name="DevicesPanel" />
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding T[Settings]}" FontSize="40" FontWeight="Bold" />
                <Button x:Name="SaveSettingsButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding T[SaveChanges]}" Click="SaveSettings_Click" IsEnabled="False" VerticalAlignment="Center" Margin="18,0,0,0" AutomationProperties.Name="{Binding T[SaveChanges]}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding T[SettingsSaveHint]}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,18" />
                <TextBlock x:Name="SettingsFeedback" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="{Binding T[DeviceName]}" Margin="0,0,0,8" />
                  <TextBox x:Name="DeviceNameInput" MaxLength="128" MaxWidth="520" HorizontalAlignment="Left" MinWidth="350" AutomationProperties.Name="{Binding T[DeviceName]}" />
                  <TextBlock Text="{Binding T[Appearance]}" Margin="0,24,0,8" />
                  <ComboBox x:Name="ThemeChoice" Width="350" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="{Binding T[Appearance]}">
                    <ComboBoxItem Content="Dunkel / Dark" />
                    <ComboBoxItem Content="Hell / Light" />
                    <ComboBoxItem Content="Windows" />
                  </ComboBox>
                  <TextBlock Text="{Binding T[Language]}" Margin="0,20,0,8" />
                  <ComboBox x:Name="LanguageChoice" Width="350" HorizontalAlignment="Left" SelectedIndex="0" AutomationProperties.Name="{Binding T[Language]}">
                    <ComboBoxItem Content="Deutsch" />
                    <ComboBoxItem Content="English" />
                  </ComboBox>
                  <CheckBox x:Name="AutostartChoice" Content="{Binding T[Autostart]}" Margin="0,22,0,24" />
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="{Binding T[Updates]}" FontSize="20" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding T[UpdateInfo]}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,15" />
                      <TextBlock x:Name="AddonUpdateHintText" Text="{Binding T[AddonUpdateHint]}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,15" />
                      <Button Content="{Binding T[CheckUpdate]}" Click="CheckUpdate_Click" HorizontalAlignment="Left" />
                      <TextBlock x:Name="UpdateText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding T[Diagnostics]}" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,8" />
                  <TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="2,12,0,0">
            <Grid VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Margin="0,0,18,0" ToolTip="{Binding T[Footer]}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" Style="{StaticResource Glyph}" Foreground="{DynamicResource Cyan}" FontSize="22" />
                <TextBlock x:Name="FooterNote" Grid.Column="1" Text="{Binding T[Footer]}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" />
              </Grid>
              <StackPanel x:Name="FooterCredits" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PreviewLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button x:Name="FooterGitHubButton" Content="GitHub" Style="{StaticResource FooterLinkButton}" Tag="{x:Static local:ProductLink.CompanionGitHub}" Click="OpenProductLink_Click" ToolTip="{Binding T[CompanionGitHubTooltip]}" AutomationProperties.Name="{Binding T[CompanionGitHubTooltip]}" AutomationProperties.HelpText="{Binding T[ExternalBrowserHint]}" />
                <TextBlock Text="·" Foreground="{DynamicResource Muted}" FontSize="12" Margin="7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BuildLabel}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource Muted}" FontSize="12" Margin="7,0" VerticalAlignment="Center" />
                <TextBlock Text="with" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                <Image Source="Assets/Heart.png" Width="13" Height="13" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0" AutomationProperties.Name="love" />
                <TextBlock Text="by krebs3r" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
