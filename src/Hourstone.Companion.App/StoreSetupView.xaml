<UserControl x:Class="Hourstone.Companion.App.StoreSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="740" Margin="12,20,12,20">
    <TextBlock Text="{Binding Steps}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,0,24" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Welcome}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding StoreEdition}" Foreground="{DynamicResource Muted}" Margin="0,7,0,26" />
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
      <StackPanel>
        <StackPanel Margin="24"><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <TextBlock Text="{Binding Summary}" Visibility="{Binding SummaryVisibility}" TextWrapping="Wrap" LineHeight="32" Margin="0,20,0,0" />
          <StackPanel x:Name="LegacyHandoverPanel" Visibility="{Binding HandoverVisibility}" Margin="0,20,0,0">
            <TextBlock Text="{Binding HandoverInstructions}" TextWrapping="Wrap" />
            <Button Content="{Binding StartupSettingsLabel}" Click="StartupSettings_Click" HorizontalAlignment="Left" Margin="0,12,0,12" />
            <CheckBox x:Name="HandoverConfirmationBox" IsChecked="{Binding LegacyHandoverConfirmed}">
              <TextBlock Text="{Binding HandoverConfirmation}" TextWrapping="Wrap" />
            </CheckBox>
          </StackPanel>
          <CheckBox Content="{Binding AutostartLabel}" IsChecked="{Binding StartWithWindows}" Visibility="{Binding AutostartVisibility}" Margin="0,22,0,0" />
          <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="14" Margin="0,22,0,0"><TextBlock Text="{Binding Information}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Muted}" /></Border>
          <TextBlock Text="{Binding FailureDetail}" Visibility="{Binding ErrorVisibility}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,16"><WrapPanel HorizontalAlignment="Right">
          <Button x:Name="SecondaryButton" Content="{Binding SecondaryLabel}" Visibility="{Binding SecondaryVisibility}" Click="Secondary_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,10,8" />
          <Button x:Name="PrimaryButton" Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}" Click="Primary_Click" IsEnabled="{Binding CanContinue}" Margin="0,0,0,8" />
        </WrapPanel></Border>
      </StackPanel>
    </Border>
  </StackPanel></ScrollViewer>
</UserControl>
